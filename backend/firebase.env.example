# Copie este arquivo para backend/firebase.env e preencha com seus dados reais.
# O backend carrega backend/firebase.env automaticamente ao rodar npm run dev/start.

FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=SEU-PROJETO
FIREBASE_API_KEY=SUA_API_KEY_WEB
FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
FIREBASE_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Recomendado para backend com regras fechadas no Realtime Database.
# Se existir backend/service-account.json, o backend carrega automaticamente.
# Opcionalmente, aponte para outro caminho:
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\caminho\service-account.json

# Alternativa: cole o JSON completo em uma linha.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Opcional: webhook HTTP para envio real de alertas WhatsApp/Evolution/Z-API.
# O backend envia POST com { message, deviceId, deviceName, geofenceName, type, createdAt }.
# WHATSAPP_WEBHOOK_URL=https://sua-api.exemplo/webhook
# WHATSAPP_WEBHOOK_TOKEN=token-opcional
